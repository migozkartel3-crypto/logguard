# Copy values into your service manager or a protected environment file.
# Do not commit real credentials.
LOGGUARD_AUTH_LOG=/var/log/auth.log
LOGGUARD_STATE_FILE=/var/lib/logguard/state.json
LOGGUARD_FAIL_THRESHOLD=5
LOGGUARD_WINDOW_SECONDS=600
LOGGUARD_ALERT_COOLDOWN_SECONDS=21600
LOGGUARD_WHITELIST=127.0.0.1,::1
LOGGUARD_POLL_SECONDS=0.5
LOGGUARD_HOST_LABEL=
LOGGUARD_LOG_LEVEL=INFO
LOGGUARD_REQUIRE_REPUTATION=false

# Optional reputation enrichment
ABUSEIPDB_API_KEY=
ABUSEIPDB_THRESHOLD=50
ABUSEIPDB_CACHE_TTL_SECONDS=86400
LOGGUARD_TELEGRAM_RETRY_SECONDS=60

# Optional Telegram alerts (set both or neither)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
